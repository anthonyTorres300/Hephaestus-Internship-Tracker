# Copy to .env.local and fill in. Never commit real values. Only NEXT_PUBLIC_* values reach the browser.

# --- Web app (Vercel + local) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public "publishable" key (formerly anon key). Safe in browsers because RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Canonical origin, used to validate auth callbacks and same-origin checks. No trailing slash.
APP_URL=http://localhost:3000
# closed_pilot | public. Must match Supabase Auth "Allow new users to sign up" setting.
REGISTRATION_MODE=closed_pilot
# Support address shown on privacy/terms pages (operator-supplied; do not use a personal address).
SUPPORT_EMAIL=support@example.com
# Salt for hashing rate-limit keys (email/IP). Any long random string.
RATE_LIMIT_SALT=change-me-to-a-long-random-string
# Version string recorded when a user accepts the terms at signup.
TERMS_VERSION=2026-10-10

# --- Optional: manual refresh from the admin UI (Vercel server only) -------
# Fine-grained token limited to "Actions: write" on GITHUB_WORKFLOW_REPO. Leave blank to disable the button.
GITHUB_WORKFLOW_DISPATCH_TOKEN=
GITHUB_WORKFLOW_REPO=owner/repo

# --- Automatic listing refresh (optional, opt-in) ----------------------------
# With these set for the web server, the app refreshes the shared listings by itself whenever it is more than 6 hours old
# (no commands needed). The role behind this URL can only run the catalog-ingestion functions, never read user data.
# For a public deployment prefer the scheduled GitHub Actions workflow and keep these OUT of the web environment.
DISCOVERY_DATABASE_URL=
DISCOVERY_DATABASE_CA_FILE=./supabase-ca.crt

# --- GitHub Actions secrets ONLY (never in Vercel, never NEXT_PUBLIC_) -----
# DISCOVERY_DATABASE_URL: TLS connection string for the restricted `discovery_ingest` role.
# SUPABASE_URL / SUPABASE_SECRET_KEY: lifecycle worker only (Auth deletion + storage cleanup).

# --- Trusted migration CI / operator only -----------------------------------
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=

# --- Local/CI tests only ---------------------------------------------------
# E2E tests need a Supabase project/local stack with synthetic users; DB tests use embedded PGlite and need nothing.
# E2E_BASE_URL=http://localhost:3000
